<Window x:Class="TransactionManagementSystem.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة المستخدمين" Height="620" Width="900" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#00695C" CornerRadius="12" Padding="20" Margin="0,0,0,15">
            <TextBlock Text="إدارة المستخدمين" FontSize="28" FontWeight="Bold" Foreground="White"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F5F7FA" CornerRadius="12" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="إضافة مستخدم جديد" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="الاسم الكامل" Margin="0,0,0,5"/>
                    <TextBox x:Name="FullNameText" Height="35" Margin="0,0,0,10"/>

                    <TextBlock Text="اسم المستخدم" Margin="0,0,0,5"/>
                    <TextBox x:Name="UsernameText" Height="35" Margin="0,0,0,10"/>

                    <TextBlock Text="البريد الإلكتروني" Margin="0,0,0,5"/>
                    <TextBox x:Name="EmailText" Height="35" Margin="0,0,0,10"/>

                    <TextBlock Text="كلمة المرور" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Height="35" Margin="0,0,0,10"/>

                    <TextBlock Text="الدور" Margin="0,0,0,5"/>
                    <ComboBox x:Name="RoleCombo" Height="35" Margin="0,0,0,20">
                        <ComboBoxItem Content="مدير"/>
                        <ComboBoxItem Content="موظف" IsSelected="True"/>
                        <ComboBoxItem Content="مشرف"/>
                    </ComboBox>

                    <Button Content="حفظ المستخدم" Height="42" Background="#43A047" Foreground="White" BorderThickness="0" Click="SaveUserButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="10">
                <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="180"/>
                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="150"/>
                        <DataGridTextColumn Header="البريد" Binding="{Binding Email}" Width="180"/>
                        <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="120"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding IsActive}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
