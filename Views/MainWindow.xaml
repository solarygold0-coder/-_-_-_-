<Window x:Class="TransactionManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.com/winfx/xaml/themes"
        Title="نظام إدارة المعاملات الصادرة والواردة"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="نظام إدارة المعاملات" FontSize="24" FontWeight="Bold" Foreground="White" Margin="10,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- لوحة التحكم -->
            <TabItem Header="لوحة التحكم" FontSize="14">
                <Grid Background="White" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- الإحصائيات -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- كارت الصادر -->
                        <Border Grid.Column="0" Background="#FF5252" CornerRadius="8" Padding="20" Margin="5">
                            <StackPanel>
                                <TextBlock Text="إجمالي الصادر" FontSize="14" Foreground="White" Opacity="0.8"/>
                                <TextBlock Text="{Binding TotalOutgoing, StringFormat='{0:N2} ر.س'}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- كارت الوارد -->
                        <Border Grid.Column="1" Background="#4CAF50" CornerRadius="8" Padding="20" Margin="5">
                            <StackPanel>
                                <TextBlock Text="إجمالي الوارد" FontSize="14" Foreground="White" Opacity="0.8"/>
                                <TextBlock Text="{Binding TotalIncoming, StringFormat='{0:N2} ر.س'}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- كارت المعلقة -->
                        <Border Grid.Column="2" Background="#FFC107" CornerRadius="8" Padding="20" Margin="5">
                            <StackPanel>
                                <TextBlock Text="المعاملات المعلقة" FontSize="14" Foreground="White" Opacity="0.8"/>
                                <TextBlock Text="{Binding PendingCount}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- جدول المعاملات -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}" 
                              AutoGenerateColumns="False" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المرجع" Binding="{Binding ReferenceNumber}" Width="100"/>
                            <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="200"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{0:N2}'}" Width="100"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDate, StringFormat='{0:yyyy-MM-dd}'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- المعاملات -->
            <TabItem Header="المعاملات" FontSize="14">
                <Grid Background="White" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="قسم المعاملات" FontSize="20" Margin="10"/>
                        <TextBlock Text="سيتم إضافة واجهة إدارة المعاملات هنا" FontSize="14" Margin="10"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- التقارير -->
            <TabItem Header="التقارير" FontSize="14">
                <Grid Background="White" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="قسم التقارير" FontSize="20" Margin="10"/>
                        <TextBlock Text="سيتم إضافة واجهة التقارير هنا" FontSize="14" Margin="10"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- الإعدادات -->
            <TabItem Header="الإعدادات" FontSize="14">
                <Grid Background="White" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="قسم الإعدادات" FontSize="20" Margin="10"/>
                        <TextBlock Text="سيتم إضافة واجهة الإعدادات هنا" FontSize="14" Margin="10"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>