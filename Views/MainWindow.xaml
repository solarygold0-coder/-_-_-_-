<Window x:Class="TransactionManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام إدارة المعاملات الصادرة والواردة"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E88E5" CornerRadius="12" Padding="20" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="نظام إدارة المعاملات الصادرة والواردة" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="SearchTextBox" Width="260" Height="32" Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="8,0"/>
                    <Button Content="بحث" Width="90" Height="35" Click="SearchButton_Click" Background="#0D47A1" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F5F7FA" CornerRadius="12" Margin="0,0,10,0" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="إضافة/تعديل المعاملة" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="رقم المرجع" Margin="0,0,0,5"/>
                        <TextBox x:Name="ReferenceNumberText" Height="35" Margin="0,0,0,10"/>

                        <TextBlock Text="العنوان" Margin="0,0,0,5"/>
                        <TextBox x:Name="TitleText" Height="35" Margin="0,0,0,10"/>

                        <TextBlock Text="الوصف" Margin="0,0,0,5"/>
                        <TextBox x:Name="DescriptionText" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="النوع" Margin="0,0,0,5"/>
                                <ComboBox x:Name="TypeCombo" Height="35">
                                    <ComboBoxItem Content="صادر"/>
                                    <ComboBoxItem Content="وارد" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="الحالة" Margin="0,0,0,5"/>
                                <ComboBox x:Name="StatusCombo" Height="35">
                                    <ComboBoxItem Content="معلقة"/>
                                    <ComboBoxItem Content="قيد التنفيذ"/>
                                    <ComboBoxItem Content="مكتملة" IsSelected="True"/>
                                    <ComboBoxItem Content="متأخرة"/>
                                    <ComboBoxItem Content="ملغاة"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="المبلغ" Margin="0,10,0,5"/>
                        <TextBox x:Name="AmountText" Height="35" Margin="0,0,0,10"/>

                        <TextBlock Text="التصنيف" Margin="0,0,0,5"/>
                        <TextBox x:Name="CategoryText" Height="35" Margin="0,0,0,10" Text="عام"/>

                        <TextBlock Text="اسم جهة الاتصال" Margin="0,0,0,5"/>
                        <TextBox x:Name="ContactNameText" Height="35" Margin="0,0,0,10"/>

                        <TextBlock Text="الهاتف" Margin="0,0,0,5"/>
                        <TextBox x:Name="ContactPhoneText" Height="35" Margin="0,0,0,10"/>

                        <TextBlock Text="البريد الإلكتروني" Margin="0,0,0,5"/>
                        <TextBox x:Name="ContactEmailText" Height="35" Margin="0,0,0,10"/>

                        <TextBlock Text="ملاحظات" Margin="0,0,0,5"/>
                        <TextBox x:Name="NotesText" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="جديد" Width="110" Height="38" Margin="0,0,10,0" Click="NewButton_Click" Background="#607D8B" Foreground="White" BorderThickness="0"/>
                            <Button Content="حفظ" Width="110" Height="38" Margin="0,0,10,0" Click="SaveButton_Click" Background="#43A047" Foreground="White" BorderThickness="0"/>
                            <Button Content="حذف" Width="110" Height="38" Click="DeleteButton_Click" Background="#E53935" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#4CAF50" CornerRadius="12" Margin="0,0,10,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="إجمالي الوارد" Foreground="White" FontSize="14" Opacity="0.85"/>
                            <TextBlock Text="{Binding TotalIncoming, StringFormat={}{0:N2} ر.س}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#F44336" CornerRadius="12" Margin="0,0,10,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="إجمالي الصادر" Foreground="White" FontSize="14" Opacity="0.85"/>
                            <TextBlock Text="{Binding TotalOutgoing, StringFormat={}{0:N2} ر.س}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFB300" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="المعاملات المعلقة" Foreground="White" FontSize="14" Opacity="0.85"/>
                            <TextBlock Text="{Binding PendingCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="10">
                    <DataGrid x:Name="TransactionsGrid" AutoGenerateColumns="False" ItemsSource="{Binding Transactions}" SelectionChanged="TransactionsGrid_SelectionChanged" BorderThickness="0" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المرجع" Binding="{Binding ReferenceNumber}" Width="110"/>
                            <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="180"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="90"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="الجهة" Binding="{Binding ContactName}" Width="150"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDate, StringFormat={}{0:yyyy/MM/dd}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
