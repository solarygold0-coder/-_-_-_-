<Window x:Class="TransactionManagementSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول"
        Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Grid Background="#F3F6FB">
        <Border Width="380" Height="360" Background="White" CornerRadius="18" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="تسجيل الدخول" FontSize="28" FontWeight="Bold" Foreground="#1E88E5" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="اسم المستخدم" FontSize="13" Margin="0,0,0,6" Foreground="#333"/>
                <TextBox x:Name="UsernameTextBox" Height="40" FontSize="16" Margin="0,0,0,15" Padding="8,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="كلمة المرور" FontSize="13" Margin="0,0,0,6" Foreground="#333"/>
                <PasswordBox x:Name="PasswordBox" Height="40" FontSize="16" Margin="0,0,0,20" Padding="8,0" VerticalContentAlignment="Center"/>

                <Button Content="دخول" Height="45" FontSize="16" FontWeight="Bold" Background="#1E88E5" Foreground="White" BorderThickness="0" Click="LoginButton_Click"/>

                <TextBlock Margin="0,20,0,0" Foreground="#607D8B" HorizontalAlignment="Center" Text="اسم المستخدم الافتراضي: admin | كلمة المرور: admin123" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
