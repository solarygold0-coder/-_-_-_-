<Window x:Class="TransactionManagementSystem.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="التقارير" Height="720" Width="1100" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D47A1" CornerRadius="12" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="التقارير والإحصاءات" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="تصدير CSV" Width="120" Height="40" Background="#43A047" Foreground="White" BorderThickness="0" Click="ExportCsvButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#4CAF50" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي الوارد" Foreground="White" Opacity="0.85"/>
                        <TextBlock x:Name="IncomingSummaryText" Text="0 ر.س" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#F44336" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي الصادر" Foreground="White" Opacity="0.85"/>
                        <TextBlock x:Name="OutgoingSummaryText" Text="0 ر.س" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FFB300" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="المعاملات المعلقة" Foreground="White" Opacity="0.85"/>
                        <TextBlock x:Name="PendingSummaryText" Text="0" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="12" Padding="10">
                <DataGrid x:Name="ReportsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم المرجع" Binding="{Binding ReferenceNumber}" Width="110"/>
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="200"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDate, StringFormat={}{0:yyyy/MM/dd}}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
