## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Rider
.idea/
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/

# Database files
*.db
*.sqlite

# Compiled files
bin/
obj/

# NuGet
.nuget/
*.nupkg

# Visual Studio cache/options
.vs/

# ReSharper
_ReSharper*/
*.DotSettings.user